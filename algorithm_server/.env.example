# 길벗 휠체어 내비게이션 - 환경변수 설정
# 이 파일을 복사하여 .env 파일로 저장하고 값을 채워주세요.

# ===== Supabase 설정 =====
# Supabase 프로젝트 URL (https://xxx.supabase.co 형식)
SUPABASE_URL=your_supabase_url_here

# Supabase 익명 키 (anon/public key)
SUPABASE_KEY=your_supabase_anon_key_here

# 서버 전용 service_role 키 (제보 Storage/DB, 장애물 만료 RPC 등)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 카카오 JavaScript 키 (내비게이션 지도 표시용)
KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_key_here

# ===== ngrok 토큰 (로컬 서버 배포용 커널) =====
NGROK_AUTHTOKEN=your_ngrok_token_here

# ===== 선택적 설정 =====
# 사전 계산된 경사도 데이터 사용 여부 (true/false)
USE_PRECOMPUTED_EDGES=true

# 실시간 DEM 고도 계산 사용 여부 (true/false, 느림)
USE_DEM_ELEVATION=false

# DEM 샘플링 간격 (미터)
DEM_SAMPLE_INTERVAL=5

# 장애물: 가장 이른 만료 시각에 맞춰 그래프를 갱신(코드 기본 동작) + 아래 주기로 백업 갱신(초). 기본 300
# 만료 RPC는 SUPABASE_SERVICE_ROLE_KEY가 있을 때 동작
OBSTACLE_EXPIRY_REFRESH_SEC=300

# ===== FCM 푸시 알림 =====
# Firebase 서비스 계정 키 JSON 파일 경로
FIREBASE_SERVICE_ACCOUNT_KEY=firebase-service-account.json

# Supabase Webhook 검증 시크릿
SUPABASE_WEBHOOK_SECRET=your_webhook_secret_here
